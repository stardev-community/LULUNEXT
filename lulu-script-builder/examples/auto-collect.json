{
  "project": { "name": "AutoCollect", "title": "Auto Collect", "theme": "Dark", "luluUrl": "https://raw.githubusercontent.com/USERNAME/REPO/main/LuluUI.lua" },
  "targets": [
    { "id": "t_quest", "alias": "Quest", "path": "Players.LocalPlayer.leaderstats.Quest", "type": "value" },
    { "id": "t_collect", "alias": "Collect", "path": "ReplicatedStorage.Remotes.Collect", "type": "remote" }
  ],
  "actions": [
    { "id": "a_collect", "name": "Collect", "kind": "fire", "targetId": "t_collect", "args": ["@widget:w_amount", "hello"] },
    { "id": "a_log", "name": "Catat", "kind": "log", "args": ["@tpl:Quest sekarang {wt:wt_quest.value}"] }
  ],
  "watchers": [
    { "id": "wt_quest", "name": "Quest berubah", "kind": "valueChanged", "targetId": "t_quest" },
    { "id": "wt_tick", "name": "Timer", "kind": "interval", "interval": "@widget:w_delay" }
  ],
  "rules": [
    { "id": "r_auto", "name": "Auto collect", "when": "wt_tick", "enabled": false, "steps": ["a_collect"] },
    { "id": "r_log", "name": "Catat quest", "when": "wt_quest", "cooldown": 1, "cond": ["@watcher:wt_quest.value", ">=", 1], "steps": ["a_log"] }
  ],
  "ui": { "tabs": [ { "name": "Main", "widgets": [
    { "id": "w_auto", "type": "Toggle", "label": "Auto Collect", "bind": "rule:r_auto" },
    { "id": "w_amount", "type": "NumberInput", "label": "Jumlah", "default": 1, "min": 1, "max": 99 },
    { "id": "w_delay", "type": "NumberInput", "label": "Jeda (detik)", "default": 2, "min": 0.2, "max": 60, "step": 0.5 },
    { "type": "InfoLabel", "label": "Quest", "src": "@watcher:wt_quest.value" },
    { "type": "Button", "label": "Collect sekali", "bind": "action:a_collect" },
    { "type": "List", "label": "Log", "isLog": true }
  ] } ] }
}
