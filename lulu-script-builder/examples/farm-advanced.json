{
  "project": { "name": "FarmPro", "title": "Farm Pro", "theme": "Midnight", "placeGuard": "warn", "luluUrl": "https://raw.githubusercontent.com/USERNAME/REPO/main/LuluUI.lua" },
  "targets": [
    { "id": "t_spot", "alias": "Spot", "path": "Workspace.Farm.Spot", "type": "instance" },
    { "id": "t_prompt", "alias": "Prompt", "path": "Workspace.Farm.Spot.ProximityPrompt", "type": "prompt" },
    { "id": "t_items", "alias": "Items", "path": "Workspace.Items", "type": "folder" },
    { "id": "t_sell", "alias": "Sell", "path": "ReplicatedStorage.Remotes.Sell", "type": "remote" }
  ],
  "actions": [
    { "id": "a_tp", "name": "Ke spot", "kind": "teleport", "targetId": "t_spot", "args": ["@target:t_spot.position"] },
    { "id": "a_take", "name": "Ambil", "kind": "prompt", "targetId": "t_prompt" },
    { "id": "a_sell", "name": "Jual", "kind": "fire", "targetId": "t_sell", "args": ["@widget:w_mode"] },
    { "id": "a_say", "name": "Info", "kind": "notify", "args": ["@tpl:Item baru: {wt:wt_item.name}"] },
    { "id": "a_loop", "name": "Ulang jual", "kind": "loop", "steps": ["a_sell"], "args": [1, 0], "until": ["@widget:w_stop", "==", true] }
  ],
  "watchers": [
    { "id": "wt_item", "name": "Item muncul", "kind": "childAdded", "targetId": "t_items", "classFilter": "Part" },
    { "id": "wt_key", "name": "Tombol F", "kind": "hotkey", "key": "F" }
  ],
  "rules": [
    { "id": "r_item", "name": "Info item", "when": "wt_item", "enabled": false, "cooldown": 0.5, "cond": { "and": [ ["@widget:w_info", "==", true], { "or": [ ["@watcher:wt_item.name", "startsWith", "Coin"], ["@watcher:wt_item.name", "contains", "Gem"] ] } ] }, "steps": ["a_say"] },
    { "id": "r_key", "name": "Hotkey jual", "when": "wt_key", "steps": ["a_sell"] }
  ],
  "macros": [ { "id": "m_farm", "name": "Farm", "loop": true, "interval": 0.5, "steps": ["a_tp", 0.4, "a_take", 1.5] } ],
  "profiles": [ { "name": "Santai", "values": { "w_mode": "Normal", "w_info": false } }, { "name": "Cepat", "values": { "w_mode": "Cepat", "w_info": true } } ],
  "ui": { "tabs": [
    { "name": "Farm", "widgets": [
      { "id": "w_farm", "type": "Toggle", "label": "Auto Farm", "bind": "macro:m_farm" },
      { "id": "w_mode", "type": "Segment", "label": "Mode", "options": ["Normal", "Cepat"], "default": "Normal" },
      { "id": "w_prof", "type": "Dropdown", "label": "Profil", "options": [], "profiles": true },
      { "type": "Accordion", "label": "Lanjutan", "children": [
        { "id": "w_info", "type": "Toggle", "label": "Info item", "bind": "rule:r_item" },
        { "id": "w_stop", "type": "Toggle", "label": "Stop loop jual" },
        { "type": "HalfButtons", "label": "Jual loop", "label2": "Jual 1x", "bind": "action:a_loop", "bind2": "action:a_sell" } ] },
      { "type": "Button", "label": "Stop Semua", "bind": "stopall" } ] }
  ], "locationPanel": true, "locations": [ { "name": "Spawn", "lanes": ["0,5,0"] } ] }
}
